PYTHONPATH=/app
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 1. Ingestion Binance → MongoDB (toutes les heures à :03)
3 * * * * python3 /app/scripts/ingest_historical.py >> /app/logs/ingest_$(date +\%Y\%m\%d).log 2>&1

# 2. ETL MongoDB → PostgreSQL (toutes les heures à :08)
8 * * * * python3 /app/scripts/run_etl.py >> /app/logs/etl_$(date +\%Y\%m\%d).log 2>&1

# 3. Pipeline complet (feature engineering + ML) (tous les jours à 02h00)
0 2 * * * bash /app/run_pipeline.sh >> /app/logs/pipeline_$(date +\%Y\%m\%d_\%H\%M\%S).log 2>&1

# 4. Nettoyage des logs > 30 jours (dimanche à 03h00)
0 3 * * 0 find /app/logs -name "*.log" -mtime +30 -delete


