PYTHONPATH=/app
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Heartbeat cron toutes les minutes
* * * * * echo "cron alive: $(date -u '+\%Y-\%m-\%d \%H:\%M:\%S UTC')" >> /app/logs/cron_heartbeat.log 2>&1

# 1. Ingestion Binance → MongoDB (toutes les heures à :03)
3 * * * * python3 /app/scripts/update_latest.py >> /app/logs/ingest_$(date +\%Y\%m\%d).log 2>&1

# 2. ETL MongoDB → PostgreSQL (toutes les heures à :08)
8 * * * * python3 /app/scripts/run_etl.py >> /app/logs/etl_$(date +\%Y\%m\%d).log 2>&1

# 3. Nettoyage des logs > 30 jours (chaque dimanche à 3h00 UTC)
0 3 * * 0 find /app/logs -name "*.log" -mtime +30 -delete
