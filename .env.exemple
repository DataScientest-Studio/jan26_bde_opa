# POSTGRES
PG_HOST=postgres
PG_PORT=5432
PG_DB=trading
PG_USER=<username>
PG_PASSWORD=<password>

# MONGODB
MONGO_INITDB_ROOT_USERNAME=<username>
MONGO_INITDB_ROOT_PASSWORD=<password>
MONGO_DB=cryptobot

# Exemple :
# mongodb://user:password@mongo:27017/cryptobot?authSource=admin
MONGO_URI=mongodb://<username>:<password>@mongo:27017/cryptobot?authSource=admin
